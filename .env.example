TARIFA_POR_KWH=450
MAX_CONCURRENT_JOBS=2
# En el Avance 2 se llenan con las URL de Reportes (Eq 4) y Mantenimiento (Eq 6)
URL_REPORTES=
URL_MANTENIMIENTO=
# Imagen local
IMAGEN=facturacion-liquidacion:local
